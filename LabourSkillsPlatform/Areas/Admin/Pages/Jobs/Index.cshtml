@page
@model LabourSkillsPlatform.Areas.Admin.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Manage Jobs";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="fw-bold mb-0">Manage Jobs</h3>
    <form method="get" class="d-flex gap-2">
        <select name="StatusFilter" class="form-select" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            @foreach (var status in Enum.GetNames<LabourSkillsPlatform.Models.JobStatus>())
            {
                <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
            }
        </select>
    </form>
</div>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Title</th><th>Employer</th><th>Category</th><th>Budget</th><th>Applications</th><th>Status</th><th class="text-end">Action</th></tr></thead>
            <tbody>
            @foreach (var job in Model.Jobs)
            {
                <tr>
                    <td class="fw-semibold">@job.Title</td>
                    <td>@job.Employer.CompanyName</td>
                    <td>@job.Category.Name</td>
                    <td>$@job.Budget.ToString("N2")</td>
                    <td>@job.Applications.Count</td>
                    <td><span class="badge badge-status-@job.Status.ToString().ToLower()">@job.Status</span></td>
                    <td class="text-end">
                        @if (job.Status is LabourSkillsPlatform.Models.JobStatus.Open or LabourSkillsPlatform.Models.JobStatus.InProgress)
                        {
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@job.Id" data-confirm="Cancel this job posting?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel Job</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Jobs.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No jobs found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
