@page
@model LabourSkillsPlatform.Areas.Labourer.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Browse Jobs";
}

<h3 class="fw-bold mb-4">Recommended Jobs For You</h3>

<div class="row g-3">
    @foreach (var (job, score) in Model.RecommendedJobs)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card p-3 h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="fw-bold mb-0">@job.Title</h6>
                    <span class="match-score-pill bg-primary text-white">@score%</span>
                </div>
                <div class="text-muted small mb-2">
                    <i class="bi bi-building"></i> @job.Employer.CompanyName<br />
                    <i class="bi bi-geo-alt"></i> @(job.Location ?? "N/A") &middot; <i class="bi bi-cash"></i> $@job.Budget.ToString("N2")
                </div>
                <p class="text-muted small flex-grow-1">@(job.Description.Length > 100 ? job.Description[..100] + "..." : job.Description)</p>
                <div class="mb-2">
                    @foreach (var js in job.JobSkills.Take(3))
                    {
                        <span class="badge bg-light text-dark border me-1">@js.Skill.Name</span>
                    }
                </div>
                @if (Model.AppliedJobIds.Contains(job.Id))
                {
                    <button class="btn btn-outline-secondary w-100" disabled>Already Applied</button>
                }
                else
                {
                    <a asp-page="Details" asp-route-id="@job.Id" class="btn btn-primary w-100">View & Apply</a>
                }
            </div>
        </div>
    }
    @if (!Model.RecommendedJobs.Any())
    {
        <div class="col-12"><p class="text-center text-muted py-5">No open jobs match your profile right now. Try adding more verified skills.</p></div>
    }
</div>
